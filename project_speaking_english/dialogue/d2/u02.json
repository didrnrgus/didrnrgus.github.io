  "items": [
    {
      "id": "D2-U02-01",
      "topic": "새 동료",
      "turns": [
        {
          "speaker": "A",
          "en": "Hi, I'm Tom. I'm new here.",
          "ko": "안녕하세요, 톰이에요. 새로 왔어요.",
          "audio": {
            "en": "audio/en/D2/D2-U02-01_t1.mp3",
            "ko": "audio/ko/D2/D2-U02-01_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Welcome! I'm Yuna.",
          "ko": "환영해요! 저는 유나예요.",
          "audio": {
            "en": "audio/en/D2/D2-U02-01_t2.mp3",
            "ko": "audio/ko/D2/D2-U02-01_t2.mp3"
          }
        },
        {
          "speaker": "A",
          "en": "Nice to meet you, Yuna.",
          "ko": "만나서 반가워요, 유나 씨.",
          "audio": {
            "en": "audio/en/D2/D2-U02-01_t3.mp3",
            "ko": "audio/ko/D2/D2-U02-01_t3.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Let me know if you need help.",
          "ko": "도움이 필요하면 말해요.",
          "audio": {
            "en": "audio/en/D2/D2-U02-01_t4.mp3",
            "ko": "audio/ko/D2/D2-U02-01_t4.mp3"
          }
        }
      ]
    },
    {
      "id": "D2-U02-02",
      "topic": "직업 묻기",
      "turns": [
        {
          "speaker": "A",
          "en": "What do you do?",
          "ko": "무슨 일 하세요?",
