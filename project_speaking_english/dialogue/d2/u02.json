            "en": "audio/en/D2/D2-U02-03_t4.mp3",
            "ko": "audio/ko/D2/D2-U02-03_t4.mp3"
          }
        }
      ]
    },
    {
      "id": "D2-U02-04",
      "topic": "나이",
      "turns": [
        {
          "speaker": "A",
          "en": "How old are you?",
