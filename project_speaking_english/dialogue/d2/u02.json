            "en": "audio/en/D2/D2-U02-02_t1.mp3",
            "ko": "audio/ko/D2/D2-U02-02_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "I'm a designer.",
          "ko": "디자이너예요.",
          "audio": {
            "en": "audio/en/D2/D2-U02-02_t2.mp3",
            "ko": "audio/ko/D2/D2-U02-02_t2.mp3"
          }
        },
        {
          "speaker": "A",
          "en": "Oh, that sounds fun.",
          "ko": "오, 재미있겠네요.",
          "audio": {
            "en": "audio/en/D2/D2-U02-02_t3.mp3",
            "ko": "audio/ko/D2/D2-U02-02_t3.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "It is! I really like it.",
          "ko": "맞아요! 정말 좋아해요.",
          "audio": {
            "en": "audio/en/D2/D2-U02-02_t4.mp3",
            "ko": "audio/ko/D2/D2-U02-02_t4.mp3"
          }
        }
      ]
    },
    {
      "id": "D2-U02-03",
      "topic": "학생",
      "turns": [
        {
          "speaker": "A",
          "en": "Are you a student?",
