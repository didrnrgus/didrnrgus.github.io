            "ko": "audio/ko/D2/D2-U02-04_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "I'm twenty-two. How about you?",
          "ko": "스물두 살이에요. 당신은요?",
          "audio": {
            "en": "audio/en/D2/D2-U02-04_t2.mp3",
            "ko": "audio/ko/D2/D2-U02-04_t2.mp3"
          }
        },
        {
          "speaker": "A",
          "en": "I'm twenty-four.",
          "ko": "저는 스물넷이에요.",
          "audio": {
            "en": "audio/en/D2/D2-U02-04_t3.mp3",
            "ko": "audio/ko/D2/D2-U02-04_t3.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Oh, you're a little older than me.",
          "ko": "아, 저보다 조금 많네요.",
          "audio": {
            "en": "audio/en/D2/D2-U02-04_t4.mp3",
            "ko": "audio/ko/D2/D2-U02-04_t4.mp3"
          }
        }
      ]
    },
    {
      "id": "D2-U02-05",
      "topic": "언어",
      "turns": [
        {
          "speaker": "A",
          "en": "Do you speak Korean?",
          "ko": "한국어 할 줄 알아요?",
