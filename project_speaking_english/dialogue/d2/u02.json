          "audio": {
            "en": "audio/en/D2/D2-U02-03_t1.mp3",
            "ko": "audio/ko/D2/D2-U02-03_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Yes, I study music.",
          "ko": "네, 음악을 공부해요.",
          "audio": {
            "en": "audio/en/D2/D2-U02-03_t2.mp3",
            "ko": "audio/ko/D2/D2-U02-03_t2.mp3"
          }
        },
        {
          "speaker": "A",
          "en": "What instrument do you play?",
          "ko": "무슨 악기 연주해요?",
          "audio": {
            "en": "audio/en/D2/D2-U02-03_t3.mp3",
            "ko": "audio/ko/D2/D2-U02-03_t3.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "I play the violin.",
          "ko": "바이올린을 켜요.",
