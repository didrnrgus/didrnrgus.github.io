  "level": "D1",
  "track": "dialogue",
  "title": "안부 묻기",
  "items": [
    {
      "id": "D1-U02-01",
      "topic": "아침 인사",
      "turns": [
        {
          "speaker": "A",
          "en": "Good morning!",
          "ko": "좋은 아침이에요!",
          "audio": {
            "en": "audio/en/D1/D1-U02-01_t1.mp3",
            "ko": "audio/ko/D1/D1-U02-01_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Morning! Did you sleep well?",
          "ko": "좋은 아침! 잘 잤어요?",
          "audio": {
            "en": "audio/en/D1/D1-U02-01_t2.mp3",
            "ko": "audio/ko/D1/D1-U02-01_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U02-02",
      "topic": "오랜만에 만남",
      "turns": [
        {
          "speaker": "A",
          "en": "Long time no see!",
          "ko": "오랜만이에요!",
          "audio": {
            "en": "audio/en/D1/D1-U02-02_t1.mp3",
            "ko": "audio/ko/D1/D1-U02-02_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Yeah! How have you been?",
          "ko": "그러게요! 어떻게 지냈어요?",
          "audio": {
            "en": "audio/en/D1/D1-U02-02_t2.mp3",
            "ko": "audio/ko/D1/D1-U02-02_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U02-03",
      "topic": "기분 묻기",
      "turns": [
        {
          "speaker": "A",
          "en": "How's it going?",
          "ko": "요즘 어때요?",
          "audio": {
            "en": "audio/en/D1/D1-U02-03_t1.mp3",
            "ko": "audio/ko/D1/D1-U02-03_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Pretty good. And you?",
          "ko": "꽤 좋아요. 당신은요?",
          "audio": {
            "en": "audio/en/D1/D1-U02-03_t2.mp3",
            "ko": "audio/ko/D1/D1-U02-03_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U02-04",
      "topic": "피곤해 보일 때",
      "turns": [
        {
          "speaker": "A",
          "en": "You look tired.",
          "ko": "피곤해 보여요.",
          "audio": {
            "en": "audio/en/D1/D1-U02-04_t1.mp3",
            "ko": "audio/ko/D1/D1-U02-04_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Yeah, I worked late.",
          "ko": "네, 늦게까지 일했어요.",
          "audio": {
            "en": "audio/en/D1/D1-U02-04_t2.mp3",
            "ko": "audio/ko/D1/D1-U02-04_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U02-05",
      "topic": "주말 안부",
      "turns": [
        {
          "speaker": "A",
          "en": "How was your weekend?",
          "ko": "주말 잘 보냈어요?",
          "audio": {
            "en": "audio/en/D1/D1-U02-05_t1.mp3",
            "ko": "audio/ko/D1/D1-U02-05_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "It was great, thanks.",
          "ko": "아주 좋았어요, 고마워요.",
          "audio": {
            "en": "audio/en/D1/D1-U02-05_t2.mp3",
            "ko": "audio/ko/D1/D1-U02-05_t2.mp3"
          }
        }
      ]
    }
  ]
}
