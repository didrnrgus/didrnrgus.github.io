            "en": "audio/en/D1/D1-U05-05_t1.mp3",
            "ko": "audio/ko/D1/D1-U05-05_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Yes, come on in!",
          "ko": "네, 들어오세요!",
          "audio": {
            "en": "audio/en/D1/D1-U05-05_t2.mp3",
            "ko": "audio/ko/D1/D1-U05-05_t2.mp3"
