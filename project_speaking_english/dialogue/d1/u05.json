      "id": "D1-U05-01",
      "topic": "가격 묻기",
      "turns": [
        {
          "speaker": "A",
          "en": "How much is this?",
          "ko": "이거 얼마예요?",
          "audio": {
            "en": "audio/en/D1/D1-U05-01_t1.mp3",
            "ko": "audio/ko/D1/D1-U05-01_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "It's five dollars.",
          "ko": "5달러예요.",
          "audio": {
            "en": "audio/en/D1/D1-U05-01_t2.mp3",
            "ko": "audio/ko/D1/D1-U05-01_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U05-02",
      "topic": "구경할 때",
      "turns": [
        {
          "speaker": "A",
          "en": "Can I help you?",
          "ko": "도와드릴까요?",
