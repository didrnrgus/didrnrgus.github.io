            "en": "audio/en/D1/D1-U05-02_t1.mp3",
            "ko": "audio/ko/D1/D1-U05-02_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "I'm just looking, thanks.",
          "ko": "그냥 구경하는 중이에요, 고마워요.",
          "audio": {
            "en": "audio/en/D1/D1-U05-02_t2.mp3",
            "ko": "audio/ko/D1/D1-U05-02_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U05-03",
      "topic": "결제 방법",
      "turns": [
        {
          "speaker": "A",
          "en": "Cash or card?",
          "ko": "현금이요, 카드요?",
          "audio": {
            "en": "audio/en/D1/D1-U05-03_t1.mp3",
            "ko": "audio/ko/D1/D1-U05-03_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Card, please.",
          "ko": "카드로 할게요.",
          "audio": {
            "en": "audio/en/D1/D1-U05-03_t2.mp3",
            "ko": "audio/ko/D1/D1-U05-03_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U05-04",
      "topic": "봉투",
      "turns": [
        {
          "speaker": "A",
          "en": "Do you need a bag?",
          "ko": "봉투 필요하세요?",
          "audio": {
            "en": "audio/en/D1/D1-U05-04_t1.mp3",
            "ko": "audio/ko/D1/D1-U05-04_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "No, I'm okay.",
          "ko": "아니요, 괜찮아요.",
          "audio": {
            "en": "audio/en/D1/D1-U05-04_t2.mp3",
            "ko": "audio/ko/D1/D1-U05-04_t2.mp3"
          }
        }
      ]
    },
    {
