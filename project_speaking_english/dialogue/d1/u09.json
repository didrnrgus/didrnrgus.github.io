{
  "unit": "D1-U09",
  "version": 1,
  "level": "D1",
  "track": "dialogue",
  "title": "확인하기",
  "items": [
    {
      "id": "D1-U09-01",
      "topic": "물건 주인",
      "turns": [
        {
          "speaker": "A",
          "en": "Is this yours?",
          "ko": "이거 당신 거예요?",
          "audio": {
            "en": "audio/en/D1/D1-U09-01_t1.mp3",
            "ko": "audio/ko/D1/D1-U09-01_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Yes, it's mine. Thanks!",
          "ko": "네, 제 거예요. 고마워요!",
          "audio": {
            "en": "audio/en/D1/D1-U09-01_t2.mp3",
            "ko": "audio/ko/D1/D1-U09-01_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U09-02",
      "topic": "자리 확인",
      "turns": [
        {
          "speaker": "A",
          "en": "Is this seat taken?",
          "ko": "이 자리 주인 있어요?",
          "audio": {
            "en": "audio/en/D1/D1-U09-02_t1.mp3",
            "ko": "audio/ko/D1/D1-U09-02_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "No, it's free.",
          "ko": "아니요, 비어 있어요.",
          "audio": {
            "en": "audio/en/D1/D1-U09-02_t2.mp3",
            "ko": "audio/ko/D1/D1-U09-02_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U09-03",
      "topic": "기차 확인",
      "turns": [
        {
          "speaker": "A",
          "en": "Is this the train to Busan?",
          "ko": "이거 부산 가는 기차예요?",
          "audio": {
            "en": "audio/en/D1/D1-U09-03_t1.mp3",
            "ko": "audio/ko/D1/D1-U09-03_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Yes, it is.",
          "ko": "네, 맞아요.",
          "audio": {
            "en": "audio/en/D1/D1-U09-03_t2.mp3",
            "ko": "audio/ko/D1/D1-U09-03_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U09-04",
      "topic": "이해 확인",
      "turns": [
        {
          "speaker": "A",
          "en": "Do you understand?",
          "ko": "이해했어요?",
          "audio": {
            "en": "audio/en/D1/D1-U09-04_t1.mp3",
            "ko": "audio/ko/D1/D1-U09-04_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Yes, I got it.",
          "ko": "네, 알겠어요.",
          "audio": {
            "en": "audio/en/D1/D1-U09-04_t2.mp3",
            "ko": "audio/ko/D1/D1-U09-04_t2.mp3"
          }
        }
      ]
    },
    {
      "id": "D1-U09-05",
      "topic": "준비물 확인",
      "turns": [
        {
          "speaker": "A",
          "en": "Do you have your passport?",
          "ko": "여권 챙겼어요?",
          "audio": {
            "en": "audio/en/D1/D1-U09-05_t1.mp3",
            "ko": "audio/ko/D1/D1-U09-05_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Yes, it's in my bag.",
          "ko": "네, 가방에 있어요.",
          "audio": {
            "en": "audio/en/D1/D1-U09-05_t2.mp3",
            "ko": "audio/ko/D1/D1-U09-05_t2.mp3"
          }
        }
      ]
    }
  ]
}
