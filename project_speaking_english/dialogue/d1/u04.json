      "topic": "밤 인사",
      "turns": [
        {
          "speaker": "A",
          "en": "Good night!",
          "ko": "잘 자요!",
          "audio": {
            "en": "audio/en/D1/D1-U04-04_t1.mp3",
            "ko": "audio/ko/D1/D1-U04-04_t1.mp3"
