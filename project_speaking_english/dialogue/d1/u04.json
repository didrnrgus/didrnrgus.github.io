            "ko": "audio/ko/D1/D1-U04-01_t1.mp3"
          }
        },
        {
          "speaker": "B",
          "en": "Okay, see you tomorrow!",
          "ko": "네, 내일 봐요!",
          "audio": {
            "en": "audio/en/D1/D1-U04-01_t2.mp3",
            "ko": "audio/ko/D1/D1-U04-01_t2.mp3"
          }
        }
      ]
    },
    {
