        {
          "speaker": "B",
          "en": "Sweet dreams!",
          "ko": "좋은 꿈 꿔요!",
          "audio": {
            "en": "audio/en/D1/D1-U04-04_t2.mp3",
            "ko": "audio/ko/D1/D1-U04-04_t2.mp3"
          }
