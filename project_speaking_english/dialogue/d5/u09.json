            "en": "audio/en/D5/D5-U09-04_t8.mp3",
            "ko": "audio/ko/D5/D5-U09-04_t8.mp3"
          }
        },
        {
          "speaker": "A",
          "en": "That sounds perfect for us.",
          "ko": "우리한테 딱이네요.",
          "audio": {
            "en": "audio/en/D5/D5-U09-04_t9.mp3",
            "ko": "audio/ko/D5/D5-U09-04_t9.mp3"
          }
        },
